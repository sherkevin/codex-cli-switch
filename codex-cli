#!/usr/bin/env python3
"""Global CODEX_HOME switcher for the Codex CLI."""
from __future__ import print_function

import argparse
import json
import os
import re
import shutil
import stat
import sys
import tempfile
from pathlib import Path


VERSION = "0.2.1"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")


class CxsError(Exception):
    pass


def manager_home():
    return Path(os.environ.get("CODEX_CLI_HOME", str(Path.home() / ".codex-cli"))).expanduser().resolve()


def state_file():
    return manager_home() / "config.json"


def official_home():
    # Reset must mean the user's normal ChatGPT/Codex home even when the
    # current shell happens to export CODEX_HOME for another instance.
    value = os.environ.get("CODEX_CLI_DEFAULT_HOME")
    return Path(value).expanduser().resolve() if value else (Path.home() / ".codex").resolve()


def atomic_write(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=str(path.parent))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, str(path))
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def validate_name(name):
    if name == "default" or not isinstance(name, str) or not NAME_RE.match(name):
        raise CxsError("配置名非法：使用字母、数字、-、_，且不要使用 default")
    return name


def load_state():
    path = state_file()
    if not path.exists():
        return {"version": 1, "active": None, "profiles": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise CxsError("无法读取全局配置 %s：%s" % (path, exc))
    if not isinstance(data, dict) or not isinstance(data.get("profiles", {}), dict):
        raise CxsError("全局配置格式错误：%s" % path)
    profiles = {}
    for name, value in data.get("profiles", {}).items():
        if not isinstance(name, str) or not NAME_RE.match(name) or name == "default":
            continue
        if isinstance(value, dict) and isinstance(value.get("CODEX_HOME"), str):
            profiles[name] = {"CODEX_HOME": str(Path(value["CODEX_HOME"]).expanduser().resolve())}
    active = data.get("active")
    if active is not None and (not isinstance(active, str) or active not in profiles):
        active = None
    return {"version": 1, "active": active, "profiles": profiles}


def save_state(state):
    clean = {
        "version": 1,
        "active": state.get("active"),
        "profiles": state.get("profiles", {}),
    }
    atomic_write(state_file(), json.dumps(clean, ensure_ascii=False, indent=2) + "\n")


def home_for(state):
    active = state.get("active")
    if active:
        return Path(state["profiles"][active]["CODEX_HOME"]).resolve()
    return official_home()


def runtime_home_path(name):
    """Return the short path used to launch an aliased Codex home."""
    return manager_home() / "homes" / name


def runtime_home_for(state):
    """Resolve the launch path while keeping the configured path unchanged.

    macOS limits Unix-domain socket paths to a short fixed length.  Cockpit
    CODEX_HOME values can exceed that limit, so an active alias is launched
    through a short symlink owned by this manager.  The symlink lives under
    the manager directory; credentials and other Codex files remain in the
    configured target directory.
    """
    active = state.get("active")
    target = home_for(state)
    if not active:
        return target
    if not target.is_dir():
        raise CxsError("当前 CODEX_HOME 目录不存在：%s" % target)

    runtime = runtime_home_path(active)
    runtime.parent.mkdir(parents=True, exist_ok=True, mode=0o700)

    # Replace only symlinks.  A real file or directory at this managed path
    # is never removed; report it so the user can resolve the collision.
    if runtime.is_symlink():
        try:
            if runtime.resolve() != target:
                runtime.unlink()
                runtime.symlink_to(target, target_is_directory=True)
        except OSError as exc:
            raise CxsError("无法更新运行时链接 %s：%s" % (runtime, exc))
    elif runtime.exists():
        raise CxsError(
            "运行时路径已被非 symlink 文件占用：%s；请移走它后重试" % runtime
        )
    else:
        try:
            runtime.symlink_to(target, target_is_directory=True)
        except OSError as exc:
            raise CxsError("无法创建运行时链接 %s：%s" % (runtime, exc))
    return runtime


def remove_runtime_home(name, target):
    """Remove this alias's link only when it still points to its old target."""
    runtime = runtime_home_path(name)
    if runtime.is_symlink():
        try:
            if runtime.resolve() == Path(target).expanduser().resolve():
                runtime.unlink()
        except OSError as exc:
            raise CxsError("无法清理运行时链接 %s：%s" % (runtime, exc))


def parse_assignment(assignment):
    prefix = "CODEX_HOME="
    if not assignment.startswith(prefix) or not assignment[len(prefix) :]:
        raise CxsError("请使用：codex-cli add NAME CODEX_HOME=/绝对路径")
    value = assignment[len(prefix) :]
    path = Path(value).expanduser().resolve()
    if not path.is_dir():
        raise CxsError("CODEX_HOME 目录不存在：%s" % path)
    return path


def cmd_add(args):
    name = validate_name(args.name)
    path = parse_assignment(args.assignment)
    state = load_state()
    old = state["profiles"].get(name)
    if old and old.get("CODEX_HOME") != str(path) and not args.force:
        raise CxsError("配置已存在：%s；如需改路径请加 --force" % name)
    state["profiles"][name] = {"CODEX_HOME": str(path)}
    if state.get("active") == name:
        runtime_home_for(state)
    save_state(state)
    print("已添加 %s -> CODEX_HOME=%s" % (name, path))
    return 0


def cmd_list(_args):
    state = load_state()
    active = state.get("active")
    marker = "*" if active is None else " "
    print("%s %-16s CODEX_HOME=%s" % (marker, "default", official_home()))
    for name in sorted(state["profiles"]):
        marker = "*" if name == active else " "
        print("%s %-16s CODEX_HOME=%s" % (marker, name, state["profiles"][name]["CODEX_HOME"]))
    return 0


def cmd_use(args):
    state = load_state()
    if args.name == "default":
        state["active"] = None
        save_state(state)
        print("已切回 default：CODEX_HOME=%s" % official_home())
        return 0
    validate_name(args.name)
    if args.name not in state["profiles"]:
        raise CxsError("找不到配置：%s；先执行 codex-cli add %s CODEX_HOME=/路径" % (args.name, args.name))
    path = Path(state["profiles"][args.name]["CODEX_HOME"])
    if not path.is_dir():
        raise CxsError("配置的 CODEX_HOME 已不存在：%s" % path)
    state["active"] = args.name
    runtime_home_for(state)
    save_state(state)
    print("已全局使用 %s：CODEX_HOME=%s" % (args.name, path))
    return 0


def cmd_reset(_args):
    state = load_state()
    state["active"] = None
    save_state(state)
    print("已恢复 ChatGPT 官方配置：CODEX_HOME=%s" % official_home())
    return 0


def cmd_remove(args):
    name = validate_name(args.name)
    state = load_state()
    if name not in state["profiles"]:
        raise CxsError("找不到配置：%s" % name)
    target = state["profiles"][name]["CODEX_HOME"]
    del state["profiles"][name]
    remove_runtime_home(name, target)
    if state.get("active") == name:
        state["active"] = None
        print("已删除 %s，并恢复 default：CODEX_HOME=%s" % (name, official_home()))
    else:
        print("已删除 %s" % name)
    save_state(state)
    return 0


def cmd_path(args):
    state = load_state()
    if args.name == "default":
        print(official_home())
        return 0
    validate_name(args.name)
    if args.name not in state["profiles"]:
        raise CxsError("找不到配置：%s" % args.name)
    print(state["profiles"][args.name]["CODEX_HOME"])
    return 0


def find_real_codex():
    explicit = os.environ.get("CODEX_REAL_BIN")
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if path.is_file() and os.access(str(path), os.X_OK):
            return str(path)
        raise CxsError("CODEX_REAL_BIN 不可执行：%s" % path)

    manager_script = Path(__file__).resolve()
    sibling_shim = manager_script.with_name("codex").resolve()
    configured_shim = os.environ.get("CODEX_SHIM_PATH")
    skip = {manager_script, sibling_shim}
    if configured_shim:
        skip.add(Path(configured_shim).expanduser().resolve())
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            directory = os.curdir
        candidate = (Path(directory) / "codex").expanduser()
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved in skip:
            continue
        if candidate.is_file() and os.access(str(candidate), os.X_OK):
            return str(candidate)
    raise CxsError("找不到真实 codex；请检查 PATH，或设置 CODEX_REAL_BIN")


def run_codex(codex_args):
    state = load_state()
    home = home_for(state)
    runtime_home = runtime_home_for(state)
    if not runtime_home.is_dir():
        raise CxsError("当前 CODEX_HOME 目录不存在：%s" % home)
    codex = find_real_codex()
    env = os.environ.copy()
    env["CODEX_HOME"] = str(runtime_home)
    os.execvpe(codex, [codex] + list(codex_args), env)
    return 0


def cmd_current(_args):
    state = load_state()
    active = state.get("active") or "default"
    print("Current: %s" % active)
    print("CODEX_HOME=%s" % home_for(state))
    if state.get("active"):
        print("Runtime CODEX_HOME=%s" % runtime_home_for(state))
    print("Config file: %s" % state_file())
    return 0


def build_parser():
    parser = argparse.ArgumentParser(
        prog="codex-cli",
        description="全局切换 Codex CLI 的 CODEX_HOME 配置",
        epilog="切换后请使用同目录的 codex shim，或执行 codex-cli run ...。",
    )
    parser.add_argument("--version", action="version", version="codex-cli %s" % VERSION)
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("add", help="添加配置：add NAME CODEX_HOME=/path")
    p.add_argument("name")
    p.add_argument("assignment")
    p.add_argument("--force", action="store_true", help="更新已有配置的路径")
    p.set_defaults(func=cmd_add)

    sub.add_parser("list", help="列出所有配置").set_defaults(func=cmd_list)

    p = sub.add_parser("use", help="全局使用 NAME；use default 回到官方配置")
    p.add_argument("name")
    p.set_defaults(func=cmd_use)

    sub.add_parser("reset", help="恢复 ChatGPT 官方配置").set_defaults(func=cmd_reset)

    p = sub.add_parser("remove", help="删除一个配置别名")
    p.add_argument("name")
    p.set_defaults(func=cmd_remove)

    p = sub.add_parser("path", help="显示某个配置的 CODEX_HOME")
    p.add_argument("name")
    p.set_defaults(func=cmd_path)

    sub.add_parser("current", help="显示当前全局选择").set_defaults(func=cmd_current)
    sub.add_parser("help", help="显示全部操作说明").set_defaults(func=None)

    # These commands are transparent pass-throughs and are handled before
    # argparse so Codex options such as --profile and --model remain untouched.
    sub.add_parser("run", help="按当前选择执行 codex")
    return parser


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)
    if raw and raw[0] in ("run", "__exec"):
        try:
            return int(run_codex(raw[1:]) or 0)
        except CxsError as exc:
            print("codex-cli: %s" % exc, file=sys.stderr)
            return 2
        except OSError as exc:
            print("codex-cli: 执行失败：%s" % exc, file=sys.stderr)
            return 2

    parser = build_parser()
    if raw and raw[0] == "help":
        parser.print_help()
        return 0
    args = parser.parse_args(raw)
    if not getattr(args, "command", None):
        parser.print_help()
        return 0
    if args.command == "run" or args.command == "__exec":
        return 0
    try:
        return int(args.func(args) or 0)
    except CxsError as exc:
        print("codex-cli: %s" % exc, file=sys.stderr)
        return 2
    except OSError as exc:
        print("codex-cli: 文件操作失败：%s" % exc, file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
